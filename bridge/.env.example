# Скопируй в .env для legacy DeepSeek-only запуска.
# Предпочтительно: Bridge Launcher → bridge/bridge_config.json

DEEPSEEK_API_KEY=sk-your-key-here

# deepseek-chat (быстро/дешево) или deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# Обычно оставь как есть
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Если Zomboid user folder не стандартный — укажи полный путь
# ZOMBOID_USER_DIR=C:\Users\USERNAME\Zomboid
